{
  "name": "@klon/example-typescript",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx index.ts",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsgo --noEmit -p .",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "fix": "pnpm run lint:fix && pnpm run format:fix"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "^2.1.1",
    "@pocketsign/klon": "workspace:",
    "@pocketsign/klon-sdk": "workspace:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
