{
  "name": "@klon/example-typescript",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx index.ts",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsgo --noEmit -p .",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "fix": "pnpm run lint:fix && pnpm run format:fix"
  },
  "dependencies": {
    "@buf/pocketsign_apis.bufbuild_es": "2.12.1-20260702064312-a4e56ca5773a.1",
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@hono/node-server": "^2.0.6",
    "@pocketsign/klon-sdk": "0.0.0-20260623090628-abe6aa552826",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4"
  },
  "packageManager": "pnpm@11.9.0"
}
